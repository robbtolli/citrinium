# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Obsidian (used to browse/edit the docs in this repo as a vault)
.obsidian/

# opentree agent worktrees / local state (not part of the product)
.opentree/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated code (drift/freezed/riverpod_generator/etc.) -- per AGENTS.md /
# docs/milestones/m0.md, CI runs `build_runner` before analyze/test, so
# these are never committed.
**/*.g.dart
**/*.freezed.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
